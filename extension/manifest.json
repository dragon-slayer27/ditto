{
  "manifest_version": 3,
  "name": "Ditto: local AI form filler",
  "short_name": "Ditto",
  "version": "0.1.1",
  "description": "Type it once. Ditto fills any form from your private profile using Gemma on your own computer (via Ollama). Nothing leaves your machine.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ditto: fill this form",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/options.html",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "commands": {
    "fill-form": {
      "suggested_key": {
        "default": "Alt+Shift+Period"
      },
      "description": "Fill the form on this page"
    }
  }
}
